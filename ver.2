<!DOCTYPE html>
<html lang="ja"><head><meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>おくすりもぐもぐ</title>
<style>
:root{
  --bg:#F4F7FC; --card:#fff; --blue:#1D4ED8; --blue-d:#1739A6; --blue-l:#EAF1FE;
  --text:#1E293B; --sub:#64748B; --border:#E2E8F0;
  --bad-bg:#FDECEC; --bad-bd:#F7C6C6; --bad-tx:#DC2626;
  --warn-bg:#FFF7E6; --warn-tx:#D97706; --warn-bd:#FCE1B0;
  --good-bg:#F0FDF4; --good-tx:#16A34A;
  --best-tx:#1D4ED8;
  --none-bg:#F1F5F9; --none-tx:#475569;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,'Hiragino Kaku Gothic ProN','Hiragino Sans',sans-serif;}
body{background:var(--bg);color:var(--text);min-height:100%;}
html,body{height:100%;}
.app{min-height:100vh;}
main{max-width:520px;margin:0 auto;padding:20px 16px calc(84px + env(safe-area-inset-bottom,0px));width:100%;}
.bottomnav{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--border);display:flex;justify-content:space-around;align-items:center;height:60px;padding-bottom:env(safe-area-inset-bottom,0px);z-index:50;}
.bottomnav a,.bottomnav button{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:.65rem;color:#94A3B8;text-decoration:none;cursor:pointer;}
.bottomnav a .ic,.bottomnav button .ic{font-size:1.25rem;}
.bottomnav a.on,.bottomnav button.on{color:var(--blue);font-weight:700;}
.page{display:none;}
.page.on{display:block;animation:f .2s;}
@keyframes f{from{opacity:0}to{opacity:1}}
.back{display:inline-flex;gap:6px;align-items:center;background:#fff;border:1px solid var(--border);padding:7px 14px;border-radius:20px;font-size:.82rem;font-weight:600;color:var(--text);cursor:pointer;margin-bottom:16px;}
h1{font-size:1.5rem;font-weight:800;text-align:center;margin-bottom:6px;}
.sub{text-align:center;color:var(--sub);font-size:.88rem;margin-bottom:20px;}
.rel{position:relative;}
.searchwrap{position:relative;max-width:560px;margin:0 auto 20px;}
.searchbox{display:flex;align-items:center;background:#fff;border:1px solid var(--border);border-radius:26px;padding:6px 6px 6px 18px;box-shadow:0 2px 10px rgba(29,78,216,.06);}
.searchbox input{flex:1;border:none;outline:none;font-size:.95rem;background:transparent;}
.searchbox button{background:var(--blue);color:#fff;border:none;padding:11px 22px;border-radius:20px;font-weight:700;font-size:.88rem;cursor:pointer;}
.suggest{position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1px solid var(--border);border-radius:12px;box-shadow:0 6px 18px rgba(0,0,0,.08);max-height:260px;overflow:auto;display:none;z-index:20;}
.suggest div{padding:10px 16px;font-size:.85rem;border-bottom:1px solid #F1F5F9;cursor:pointer;}
.suggest div:hover{background:var(--blue-l);}
.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px;}
.fcard{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px 10px;text-align:center;cursor:pointer;}
.fcard.hi{background:linear-gradient(135deg,#3B6DF0,var(--blue-d));color:#fff;border:none;}
.fcard .ic{font-size:1.5rem;margin-bottom:8px;}
.fcard .t{font-weight:700;font-size:.92rem;}
.fcard .d{font-size:.72rem;opacity:.85;margin-top:2px;}
footer{text-align:center;font-size:.72rem;color:var(--sub);margin-top:28px;}
footer b{color:#B45309;}
/* 相性チェックフォーム */
.formcard{background:#fff;border:1px solid var(--border);border-radius:18px;padding:22px;margin-bottom:18px;}
.flabel{display:flex;align-items:center;gap:8px;font-weight:700;font-size:.9rem;margin-bottom:8px;}
.dot{width:22px;height:22px;border-radius:50%;background:var(--blue-l);flex-shrink:0;}
.finput{width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:10px;font-size:.92rem;margin-bottom:16px;outline:none;}
.finput:focus{border-color:var(--blue);}
.bigbtn{width:100%;background:var(--blue);color:#fff;border:none;padding:14px;border-radius:12px;font-weight:700;font-size:.95rem;cursor:pointer;}
.chip-row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;}
.chip{background:var(--blue-l);color:var(--blue-d);border-radius:12px;padding:10px 14px;font-size:.82rem;font-weight:600;cursor:pointer;}
/* 判定結果2カラム */
.res-grid{display:grid;grid-template-columns:1fr;gap:16px;}
@media(min-width:600px){.res-grid{grid-template-columns:1.5fr 1fr;}}
.res-main{background:#fff;border-radius:16px;padding:20px;border:1px solid var(--border);}
.res-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;}
.res-name{font-size:1.1rem;font-weight:800;}
.badge{display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border-radius:20px;font-weight:700;font-size:.78rem;}
.badge.bad{background:var(--bad-tx);color:#fff;}
.badge.warn{background:var(--warn-tx);color:#fff;}
.badge.good{background:var(--good-tx);color:#fff;}
.badge.best{background:var(--blue);color:#fff;}
.badge.none{background:var(--none-tx);color:#fff;}
.box{border-radius:12px;padding:14px;font-size:.85rem;line-height:1.6;margin-bottom:12px;}
.box.reason{background:#FFF7ED;color:#92400E;}
.box.tip{background:var(--blue-l);color:var(--blue-d);}
.tagline{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
.tagline span{background:#fff;border:1px solid var(--border);padding:4px 10px;border-radius:14px;font-size:.75rem;}
.side-card{background:#fff;border-radius:16px;padding:18px;border:1px solid var(--border);margin-bottom:14px;}
.side-card h3{font-size:.85rem;font-weight:700;margin-bottom:10px;display:flex;gap:6px;align-items:center;}
.nbig{font-size:1.6rem;font-weight:800;color:var(--blue);}
.side-card p{font-size:.78rem;color:var(--sub);margin-top:6px;line-height:1.5;}
.guide-btn{width:100%;background:var(--blue-d);color:#fff;border:none;padding:11px;border-radius:10px;font-weight:700;font-size:.85rem;margin-top:10px;cursor:pointer;}
/* 薬詳細ページ */
.dh{background:#fff;border-radius:16px;padding:18px 20px;border:1px solid var(--border);margin-bottom:18px;}
.dh .n{font-size:1.3rem;font-weight:800;}
.dh .c{font-size:.82rem;color:var(--sub);margin-top:2px;}
.tier{border-radius:16px;padding:18px;margin-bottom:14px;border:2px solid;}
.tier.bad{background:var(--bad-bg);border-color:var(--bad-bd);}
.tier.heat{background:var(--warn-bg);border-color:var(--warn-bd);}
.tier.heat .th{color:var(--warn-tx);}
.tier.heat .tier-grid .ti{color:var(--warn-tx);}
.alert-banner{background:var(--bad-tx);color:#fff;font-weight:800;font-size:.98rem;padding:12px 16px;border-radius:12px;display:flex;align-items:center;gap:8px;margin-bottom:14px;box-shadow:0 2px 8px rgba(220,38,38,.25);}
.tier .th{font-weight:800;font-size:1rem;display:flex;gap:8px;align-items:center;margin-bottom:12px;color:var(--bad-tx);}
.tier-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(104px,1fr));gap:8px;margin-bottom:10px;}
.tier-grid .ti{background:#fff;border-radius:10px;padding:10px 4px;text-align:center;font-size:.75rem;font-weight:700;color:var(--bad-tx);}
.tier-grid .ti span{display:block;font-size:1.2rem;margin-bottom:4px;}
.tier .desc{background:#fff;padding:10px 12px;border-radius:8px;font-size:.8rem;line-height:1.5;color:#444;}
.sec2{font-weight:700;font-size:.95rem;margin:18px 0 10px;display:flex;gap:6px;align-items:center;}
.card2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.icard{background:#fff;border-radius:12px;padding:12px;border:1px solid var(--border);}
.icard .it{font-weight:700;font-size:.85rem;margin-bottom:4px;}
.icard .id{font-size:.72rem;color:var(--sub);line-height:1.4;}
.notice{background:#fff;border:1px dashed #CBD5E1;border-radius:12px;padding:14px;font-size:.78rem;color:var(--sub);margin-top:18px;line-height:1.6;}
/* お薬ノート */
.datebar{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid var(--border);border-radius:12px;padding:10px 16px;margin-bottom:16px;font-weight:700;font-size:.9rem;}
.datebar span{cursor:pointer;color:var(--blue);font-size:1rem;}
.note-card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:12px;}
.note-top{display:flex;justify-content:space-between;align-items:center;font-size:.78rem;color:var(--sub);margin-bottom:6px;}
.note-top .st{padding:2px 8px;border-radius:10px;font-size:.7rem;font-weight:700;}
.st.ok{background:var(--good-bg);color:var(--good-tx);}
.st.warn{background:var(--warn-bg);color:var(--warn-tx);}
.st.bad{background:var(--bad-bg);color:var(--bad-tx);}
.st.good{background:var(--good-bg);color:var(--good-tx);}
.st.best{background:var(--blue-l);color:var(--blue-d);}
.opt-btn{display:flex;align-items:center;gap:8px;text-align:left;background:#fff;border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-size:.85rem;cursor:pointer;width:100%;}
.opt-btn:hover{background:var(--bg);}
.opt-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.opt-dot.bad{background:var(--bad-tx);}
.opt-dot.warn{background:var(--warn-tx);}
.opt-dot.good{background:var(--good-tx);}
.opt-dot.best{background:var(--blue);}
.note-name{font-weight:700;font-size:.95rem;margin-bottom:6px;}
.note-mix{background:var(--bg);border-radius:8px;padding:8px 10px;font-size:.8rem;line-height:1.5;}
.addbtn{width:100%;background:var(--blue);color:#fff;border:none;padding:12px;border-radius:12px;font-weight:700;cursor:pointer;margin-top:6px;}
/* アラーム */
.al-master{background:var(--blue-l);border-radius:14px;padding:16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
.al-card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:14px;}
.al-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
.al-top .n{font-weight:700;font-size:.95rem;}
.al-top .d{font-size:.75rem;color:var(--sub);}
.al-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px solid #F1F5F9;font-size:.85rem;}
.al-row b{font-size:1rem;}
sw{--w:44px;display:inline-block;}
.tgl{width:44px;height:26px;border-radius:14px;background:#CBD5E1;position:relative;cursor:pointer;flex-shrink:0;}
.tgl.on{background:var(--blue);}
.tgl i{position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:.2s;}
.tgl.on i{left:21px;}
.note-form input{width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:10px;margin-bottom:10px;font-size:.88rem;outline:none;}
.notreg{text-align:center;padding:40px 20px;color:var(--sub);font-size:.88rem;}
.modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:300;padding:20px;}
.modal-overlay.show{display:flex;}
.modal-box{background:#fff;border-radius:18px;padding:22px;max-width:340px;width:100%;}
.modal-box h3{font-size:1.05rem;margin-bottom:10px;}
.modal-box p{font-size:.86rem;color:var(--sub);margin-bottom:14px;line-height:1.5;}
.modal-box input{width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:10px;margin-bottom:12px;font-size:.9rem;outline:none;}
.modal-actions{display:flex;gap:10px;}
.modal-actions button{flex:1;padding:11px;border-radius:10px;font-weight:700;border:none;cursor:pointer;font-size:.85rem;}
.modal-actions .cancel{background:#F1F5F9;color:var(--text);}
.modal-actions .ok{background:var(--blue);color:#fff;}
.verdict{border-radius:18px;padding:26px 16px;text-align:center;margin-bottom:16px;color:#fff;}
.verdict.bad{background:linear-gradient(135deg,#EF4444,var(--bad-tx));}
.verdict.warn{background:linear-gradient(135deg,#F59E0B,var(--warn-tx));}
.verdict.good{background:linear-gradient(135deg,#22C55E,var(--good-tx));}
.verdict.best{background:linear-gradient(135deg,#3B82F6,var(--blue-d));}
.verdict.none{background:linear-gradient(135deg,#94A3B8,var(--none-tx));}
.verdict .vi{font-size:2.6rem;line-height:1;margin-bottom:8px;}
.verdict .vt{font-size:1.35rem;font-weight:800;}
.disclaimer-note{font-size:.74rem;color:var(--sub);text-align:center;line-height:1.5;margin:-6px 0 16px;}
.box.source{background:#F1F5F9;color:#334155;}
/* アクセシビリティ：フォーカス表示 */
a:focus-visible, button:focus-visible, input:focus-visible, .fcard:focus-visible, .chip:focus-visible, .tgl:focus-visible, [tabindex]:focus-visible{
  outline:3px solid var(--blue); outline-offset:2px;
}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
button.fcard, button.chip{font:inherit;text-align:center;}
button.chip{text-align:left;}
.suggest button.sugg-item{display:block;width:100%;text-align:left;background:none;border:none;padding:10px 16px;font-size:.85rem;border-bottom:1px solid #F1F5F9;cursor:pointer;font:inherit;color:inherit;}
.suggest button.sugg-item:hover, .suggest button.sugg-item.hi{background:var(--blue-l);}
.searchstatus{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
.alarm-actions{display:flex;gap:8px;margin-top:10px;}
.alarm-actions button{flex:1;background:#F1F5F9;border:none;border-radius:8px;padding:8px;font-size:.78rem;font-weight:700;color:var(--text);cursor:pointer;}
.alarm-actions button.danger{background:var(--bad-bg);color:var(--bad-tx);}
.notif-status{font-size:.7rem;padding:2px 8px;border-radius:8px;margin-top:6px;display:inline-block;}
.notif-status.ok{background:var(--good-bg);color:var(--good-tx);}
.notif-status.no{background:var(--bad-bg);color:var(--bad-tx);}
.note-actions{display:flex;gap:8px;margin-top:8px;}
.note-actions button{background:#F1F5F9;border:none;border-radius:8px;padding:6px 10px;font-size:.72rem;font-weight:700;color:var(--text);cursor:pointer;}
.note-actions button.danger{background:var(--bad-bg);color:var(--bad-tx);}
.bottomnav button.nav{background:none;border:none;font:inherit;}

/* ---- ホーム：薬名検索を主役に ---- */
.hero{background:linear-gradient(135deg,#DCE8FD 0%,#F4F8FF 100%);border:2px solid #BFD3FB;border-radius:24px;padding:28px 16px 22px;margin-bottom:14px;box-shadow:0 6px 22px rgba(29,78,216,.14);}
.hero-label{display:block;font-weight:800;font-size:1.2rem;color:var(--blue-d);margin-bottom:14px;text-align:center;}
.hero .searchwrap{margin-bottom:0;}
.searchbox.big{border:3px solid var(--blue);padding:8px 8px 8px 22px;min-height:68px;border-radius:34px;}
.searchbox.big input{font-size:1.15rem;min-width:0;}
.searchbox.big button{padding:16px 28px;font-size:1.02rem;}
.hero-hint{text-align:center;font-size:.78rem;color:var(--sub);margin-top:10px;}
.trust-note{background:#F8FAFC;border:1px solid var(--border);color:var(--sub);border-radius:12px;padding:10px 12px;font-size:.76rem;line-height:1.55;margin-bottom:22px;}
.sec-title{font-size:.82rem;font-weight:700;color:var(--sub);margin-bottom:10px;}
.cards3 .fcard{padding:14px 8px;}
.cards3 .fcard .ic{font-size:1.25rem;margin-bottom:4px;}
.cards3 .fcard .d{font-size:.7rem;}
/* ---- 薬の詳細：飲食品との相性一覧 ---- */
.dsec{margin-bottom:24px;}
.dsec-h{font-size:1.05rem;font-weight:800;margin-bottom:4px;}
.dsec-sub{font-size:.76rem;color:var(--sub);margin-bottom:12px;line-height:1.55;}
.none-note{background:var(--none-bg);border:1px solid #CBD5E1;border-radius:12px;padding:10px 12px;font-size:.78rem;color:var(--none-tx);line-height:1.55;margin-bottom:12px;}
.legend{background:#fff;border:1px solid var(--border);border-radius:12px;padding:10px 14px;margin-bottom:12px;font-size:.78rem;}
.legend summary{cursor:pointer;font-weight:700;color:var(--blue-d);}
.legend ul{list-style:none;margin-top:8px;display:grid;gap:8px;line-height:1.5;}
.grp{margin-bottom:18px;}
.grp-h{display:flex;align-items:center;gap:8px;font-weight:800;font-size:1rem;padding:10px 14px;border-radius:12px;}
.grp-h .grp-n{margin-left:auto;font-size:.76rem;font-weight:700;opacity:.85;}
.grp.g-bad .grp-h{background:var(--bad-bg);color:var(--bad-tx);border:1px solid var(--bad-bd);}
.grp.g-warn .grp-h{background:var(--warn-bg);color:var(--warn-tx);border:1px solid var(--warn-bd);}
.grp.g-good .grp-h{background:var(--good-bg);color:var(--good-tx);border:1px solid #A7F3D0;}
.grp.g-none .grp-h{background:var(--none-bg);color:var(--none-tx);border:1px solid #CBD5E1;}
.grp-d{font-size:.76rem;color:var(--sub);line-height:1.55;padding:8px 4px 10px;}
.grp-empty{font-size:.78rem;color:var(--sub);padding:2px 4px 4px;}
.fchips{display:none;}
.water{background:#EFF6FF;border:1px solid #BFDBFE;border-radius:14px;padding:14px;margin-bottom:20px;}
.water-h{font-weight:800;font-size:.95rem;color:var(--blue-d);}
.water-name{font-size:1.6rem;font-weight:800;margin:2px 0 4px;}
.water-d{font-size:.76rem;color:var(--sub);line-height:1.55;}
.water-info{margin-top:12px;border-top:1px dashed #BFDBFE;padding-top:10px;}
.water-info>b{display:block;font-size:.78rem;margin-bottom:8px;line-height:1.5;}
.chips{display:flex;flex-wrap:wrap;gap:8px;}
.fchipx{border:1.5px solid var(--border);background:#fff;border-radius:18px;padding:8px 14px;font:inherit;font-size:.84rem;font-weight:600;color:var(--text);cursor:pointer;text-align:left;max-width:100%;word-break:break-word;line-height:1.4;}
.grp.g-bad .fchipx{border-color:var(--bad-bd);}
.grp.g-warn .fchipx{border-color:var(--warn-bd);}
.grp.g-good .fchipx{border-color:#A7F3D0;}
.grp.g-none .fchipx{border-color:#CBD5E1;}
.fchipx.on{background:var(--blue);color:#fff;border-color:var(--blue);}
.fpanel{margin-top:10px;background:#fff;border:1px solid var(--border);border-radius:12px;padding:12px 14px;font-size:.8rem;line-height:1.6;color:#334155;}
.fp-title{font-weight:800;font-size:.9rem;margin-bottom:2px;}
.why{font-size:.8rem;line-height:1.55;background:#fff;border:1px solid var(--bad-bd);border-radius:10px;padding:8px 12px;margin-bottom:8px;color:#334155;}
.why b{color:var(--bad-tx);}

.fchip{border:1px solid var(--border);background:#fff;border-radius:16px;padding:7px 12px;font:inherit;font-size:.76rem;font-weight:700;cursor:pointer;color:var(--text);}
.fchip.on{background:var(--blue);color:#fff;border-color:var(--blue);}
.frow{background:#fff;border:1px solid var(--border);border-left-width:6px;border-radius:12px;margin-bottom:8px;overflow:hidden;}
.frow.j-bad{border-left-color:var(--bad-tx);}
.frow.j-warn{border-left-color:var(--warn-tx);}
.frow.j-good{border-left-color:var(--good-tx);}
.frow.j-none{border-left-color:#94A3B8;}
.frow summary{list-style:none;display:flex;align-items:center;gap:10px;padding:12px 12px 12px 14px;cursor:pointer;min-height:48px;}
.frow summary::-webkit-details-marker{display:none;}
.frow .fname{flex:1;min-width:0;font-weight:700;font-size:.88rem;line-height:1.4;word-break:break-word;}
.frow .ftype{display:block;font-weight:400;font-size:.7rem;color:var(--sub);margin-top:2px;}
.frow .chev{color:var(--sub);font-size:1rem;transition:transform .15s;}
.frow[open] .chev{transform:rotate(90deg);}
.badge{flex-shrink:0;border-radius:14px;padding:4px 10px;font-size:.74rem;font-weight:800;white-space:nowrap;}
.badge.bad{background:var(--bad-bg);color:var(--bad-tx);border:1px solid var(--bad-bd);}
.badge.warn{background:var(--warn-bg);color:var(--warn-tx);border:1px solid var(--warn-bd);}
.badge.good{background:var(--good-bg);color:var(--good-tx);border:1px solid #A7F3D0;}
.badge.none{background:var(--none-bg);color:var(--none-tx);border:1px solid #CBD5E1;}
.fbody{padding:2px 14px 14px;font-size:.8rem;line-height:1.6;color:#334155;border-top:1px dashed var(--border);}
.fb{margin-top:10px;white-space:pre-line;}
.fb b{display:block;font-size:.72rem;color:var(--sub);margin-bottom:2px;}
.tipitem{background:#fff;border:1px solid var(--border);border-left:6px solid var(--blue);border-radius:12px;padding:12px 14px;margin-bottom:8px;}
.tipitem .tt{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;font-weight:700;font-size:.86rem;line-height:1.4;}
.tipitem .ti-do{margin-top:6px;font-size:.84rem;line-height:1.55;}
.tipitem summary{font-size:.74rem;color:var(--blue-d);cursor:pointer;margin-top:8px;font-weight:700;}

/* ---- 検索候補（成分・剤形・メーカー）---- */
.sugg-item{min-height:48px;}
.sg-name{display:block;font-weight:700;font-size:.88rem;line-height:1.4;}
.sg-sub{display:block;font-size:.72rem;color:var(--sub);margin-top:2px;line-height:1.45;}
.sugg-more{padding:9px 16px;font-size:.72rem;color:var(--sub);background:#F8FAFC;line-height:1.5;}
/* ---- 資料で確認できなかった範囲 ---- */
.range-item{background:var(--none-bg);border:1px solid #CBD5E1;border-left:6px solid #94A3B8;border-radius:12px;padding:12px 14px;margin-bottom:8px;font-size:.8rem;line-height:1.6;color:#334155;}
.range-item .ri-t{font-weight:800;font-size:.86rem;}
/* ---- スマートフォンでの操作性 ---- */
.datebar span{min-width:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;}
.note-actions button{padding:10px 16px;min-height:40px;font-size:.78rem;}
.fchipx{min-height:40px;}
@media(max-width:599px){ input{font-size:16px;} }
</style>
</head>
<body>
<div class="app">
<main>

<!-- ホーム -->
<section class="page on" id="home">
  <h1>今日のおくすり、どうやって飲ませる？</h1>
  <p class="sub">お薬の名前を入れると、一緒に使いたい飲食品との相性がわかります。</p>
  <div class="hero">
    <label for="homeSearch" class="hero-label">🔍 お薬の名前を入力してください</label>
    <div class="searchwrap">
      <div class="searchbox big">
        <input id="homeSearch" placeholder="例：クラリス、カルボシステイン" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="suggestBox" aria-autocomplete="list">
        <button type="button" onclick="doSearch()">検索</button>
      </div>
      <div class="suggest" id="suggestBox" role="listbox" aria-label="候補" style="display: none;"></div>
      <div class="searchstatus" id="searchStatus" aria-live="polite"></div>
    </div>
    <p class="hero-hint">候補が出たら、お薬をタップすると、その薬の飲食品との相性が一覧で開きます</p>
  </div>
  <p class="trust-note">📄 添付文書・インタビューフォームなどの資料に基づく参考情報です。実際の服薬については、必ず医師・薬剤師の指示を優先してください。</p>
  <p class="sec-title">ほかの機能</p>
  <div class="cards3">
    <button type="button" class="fcard" onclick="go('checkform')"><div class="ic" aria-hidden="true">⚖️</div><div class="t">相性チェック</div><div class="d">特定の薬×飲食品をピンポイントで確認</div></button>
    <button type="button" class="fcard" onclick="go('note')"><div class="ic" aria-hidden="true">📖</div><div class="t">お薬ノート</div><div class="d">記録を確認する</div></button>
    <button type="button" class="fcard" onclick="go('alarm')"><div class="ic" aria-hidden="true">⏰</div><div class="t">のみ忘れ防止</div><div class="d">アラーム設定</div></button>
  </div>
  <footer><b>おくすりもぐもぐ</b><br>© 2026 未来探究プロジェクト 開発：城ノ内中等教育学校 宗本漣</footer>
</section>

<!-- 相性チェック 入力フォーム -->
<section class="page" id="checkform">
  <div class="back" onclick="go('home')">← 戻る</div>
  <h1 style="color:var(--blue);">相性チェック</h1>
  <p class="sub">特定のお薬と、特定の飲食品の相性をピンポイントで確認します</p>
  <div class="formcard">
    <label class="flabel" for="ckDrug"><span class="dot" aria-hidden="true"></span>お薬の名前を入力</label>
    <div class="rel">
      <input class="finput" id="ckDrug" placeholder="薬の名前を入力（例：クラリス、くらりす）" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="ckSuggestBox" aria-autocomplete="list">
      <div class="suggest" id="ckSuggestBox" role="listbox" aria-label="候補" style="display: none;"></div>
      <div class="searchstatus" id="ckStatus" aria-live="polite"></div>
    </div>
    <label class="flabel" for="ckFood"><span class="dot" style="background:#FFF3E0;" aria-hidden="true"></span>飲食品を入力</label>
    <input class="finput" id="ckFood" placeholder="飲食品を入力（例：オレンジジュース）">
    <button class="bigbtn" onclick="runCheck()">相性を判定する →</button>
  </div>
  <p class="sub" style="margin-bottom:10px;">よく調べられる組み合わせ</p>
  <div class="chip-row">
    <button type="button" class="chip" onclick="quick('クラリスロマイシンＤＳ小児用１０％「タカタ」　１００ｍｇ','オレンジジュース')">クラリス + オレンジジュース</button>
    <button type="button" class="chip" onclick="quick('カルボシステインシロップ小児用５％「トーワ」','らくらく服薬ゼリー')">カルボシステイン + ゼリー</button>
  </div>
</section>

<!-- 相性判定結果（ペア） -->
<section class="page" id="result">
  <div class="back" onclick="go('checkform')">← 戻る</div>
  <h1 id="resTitle" style="font-size:1.25rem;">相性チェック結果</h1>
  <p class="sub" id="resSub">お薬と飲食品の組み合わせについての参考情報です</p>
  <div class="res-grid">
    <div class="res-main" aria-live="polite">
      <div class="verdict" id="verdictBox">
        <div class="vi" id="verdictIcon" aria-hidden="true">?</div>
        <div class="vt" id="verdictText">-</div>
      </div>
      <p class="disclaimer-note">※参考情報です。実際の服薬については必ず医師・薬剤師にご確認ください。</p>
      <div class="res-top">
        <div><div class="res-name" id="resDrugFood">-</div></div>
      </div>
      <div class="box tip"><b>📌 この判定の意味</b><br><span id="resMeaning"></span></div>
      <div class="box reason"><b>⚠ 理由</b><br><span id="resReason"></span></div>
      <div class="box tip"><b>💡 注意事項・工夫</b><br><span id="resTip"></span>
        <div class="tagline" id="resTagline"></div>
      </div>
      <div class="box source"><b>📄 出典</b><br><span id="resSource"></span></div>
      <div class="formcard" style="padding:16px;">
        <p style="font-weight:700;font-size:.85rem;margin-bottom:10px;">次にすること</p>
        <button class="bigbtn" style="margin-bottom:8px;" onclick="askSaveNoteFromResult()">📖 この結果をお薬ノートに保存する</button>
        <button class="bigbtn" style="background:var(--blue-l);color:var(--blue-d);" onclick="askSetAlarm()">⏰ 飲み忘れ防止のアラームを設定する</button>
      </div>
    </div>
    <div>
      <div class="side-card">
        <h3>お薬の飲ませ方に困ったら？</h3>
        <p>お薬ノートに記録して、次回の参考にしましょう。</p>
        <button class="guide-btn" onclick="go('note')">お薬ノートを見る</button>
      </div>
    </div>
  </div>
</section>

<!-- 薬詳細（検索結果） -->
<section class="page" id="detail">
  <div class="back" onclick="go('home')">← ホームに戻る</div>
  <div class="dh"><div class="n" id="dtName">-</div><div class="c" id="dtCat">-</div></div>
  <div id="dtBody" aria-live="polite"></div>
  <div class="formcard" style="padding:16px;">
    <p style="font-weight:700;font-size:.85rem;margin-bottom:10px;">次にすること</p>
    <button class="bigbtn" style="margin-bottom:8px;background:var(--blue-l);color:var(--blue-d);" onclick="goCheckFromDetail()">⚖️ この薬と飲食品を個別に調べる</button>
    <button class="bigbtn" style="margin-bottom:8px;" onclick="askSaveNoteFromDetail()">📖 お薬ノートに保存する</button>
    <button class="bigbtn" style="background:var(--blue-l);color:var(--blue-d);" onclick="askSetAlarm()">⏰ 飲み忘れ防止のアラームを設定する</button>
  </div>
</section>

<!-- お薬ノート -->
<section class="page" id="note">
  <div class="back" onclick="go('home')">← ホームに戻る</div>
  <h1 style="text-align:left;font-size:1.3rem;">📖 お薬ノート</h1>
  <p class="sub" style="text-align:left;">お子様の服薬の経過を記録しましょう。</p>
  <div class="datebar"><span onclick="shiftDate(-1)">‹</span><span id="noteDate">今日</span><span onclick="shiftDate(1)">›</span></div>
  <div id="noteList"><div class="notreg">この日の記録はまだありません。</div></div>
  <div class="formcard note-form" style="margin-top:14px;">
    <label class="sr-only" for="nDrug">お薬の名前</label>
    <input id="nDrug" aria-label="お薬の名前" placeholder="お薬の名前（例：カルボシステイン）">
    <label class="sr-only" for="nFood">服薬時に使った飲食品</label>
    <input id="nFood" aria-label="服薬時に使った飲食品" placeholder="服薬時に使った飲食品（例：チョコアイス）">
    <label class="sr-only" for="nMemo">メモ</label>
    <input id="nMemo" aria-label="メモ" placeholder="メモ（例：嫌がらずに飲めた）">
    <button class="addbtn" onclick="addNote()">＋ 手動で記録を追加</button>
  </div>
</section>

<!-- アラーム -->
<section class="page" id="alarm">
  <div class="back" onclick="go('home')">← ホームに戻る</div>
  <h1 style="text-align:left;font-size:1.3rem;">⏰ アラーム設定</h1>
  <p class="sub" style="text-align:left;">飲み忘れを防ぐための通知時間を設定します。</p>
  <div class="notice" id="notifBanner" style="margin-top:0;margin-bottom:16px;"><b>ℹ 通知についての注意</b><br>通知は「このタブを開いている間」のみ有効です。タブを閉じたり、別のアプリに切り替えたままにすると通知されません。飲み忘れ防止の補助としてご利用ください。</div>
  <div class="al-master"><div><b>すべてのアラーム</b><div style="font-size:.78rem;color:var(--sub);">一時的にすべての通知を停止します</div></div>
    <div class="tgl on" id="masterToggle" role="switch" tabindex="0" aria-checked="true" onclick="toggleMasterMute()" onkeydown="if(event.key===' '||event.key==='Enter'){event.preventDefault();toggleMasterMute();}"><i></i></div>
  </div>
  <div id="alarmList" aria-live="polite"><div class="notreg">アラームはまだありません。</div></div>
  <button class="bigbtn" onclick="manualAddAlarm()">＋ 新しいアラームを追加</button>
</section>

</main>
<nav class="bottomnav">
  <button type="button" class="nav on" data-p="home"><span class="ic" aria-hidden="true">🏠</span>ホーム</button>
  <button type="button" class="nav" data-p="checkform"><span class="ic" aria-hidden="true">⚖️</span>相性チェック</button>
  <button type="button" class="nav" data-p="note"><span class="ic" aria-hidden="true">📖</span>お薬ノート</button>
  <button type="button" class="nav" data-p="alarm"><span class="ic" aria-hidden="true">⏰</span>アラーム</button>
</nav>
<div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true"><div class="modal-box" id="modalBox" tabindex="-1"></div></div>
</div>

