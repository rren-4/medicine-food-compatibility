/* お薬ノートロジック */
function getStorage(key) {
  try { return JSON.parse(localStorage.getItem(key)) || []; } catch(e) { return []; }
}
function setStorage(key, val) {
  try { localStorage.setItem(key, JSON.stringify(val)); } catch(e) {}
}

/* 端末のローカル日付（日本ならJST）で YYYY-MM-DD をつくる。toISOString はUTC基準のため使わない */
function localDateKey(d) {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

function getDateKey(offset = 0) {
  const d = new Date();
  d.setDate(d.getDate() + offset);
  return localDateKey(d);
}

function shiftDate(dir) {
  currentDateOffset += dir;
  const d = new Date();
  d.setDate(d.getDate() + currentDateOffset);
  const m = d.getMonth() + 1;
  const dateNum = d.getDate();
  const label = currentDateOffset === 0 ? `今日 ${m}月${dateNum}日` : `${m}月${dateNum}日`;
  document.getElementById('noteDate').textContent = label;
  renderNotes();
}

function renderNotes() {
  const key = getDateKey(currentDateOffset);
  const notes = getStorage('notes_' + key);
  const container = document.getElementById('noteList');
  if (notes.length === 0) {
    container.innerHTML = '<div class="notreg">この日の記録はまだありません。</div>';
    return;
  }
  /* 入力された薬剤名・飲食品名・メモは、すべてエスケープして表示する */
  container.innerHTML = notes.map((item, idx) => `
    <div class="note-card">
      <div class="note-top">
        <span>${esc(item.time || '')}</span>
        <span class="st ok">記録済み</span>
      </div>
      <div class="note-name">${esc(item.drug)}</div>
      ${item.food ? `<div class="note-mix">服薬時に使った飲食品: ${esc(item.food)}</div>` : ''}
      ${item.memo ? `<div style="font-size:.78rem;color:var(--sub);margin-top:4px;">メモ: ${esc(item.memo)}</div>` : ''}
      <div class="note-actions">
        <button class="danger" onclick="deleteNote('${key}', ${idx})">削除</button>
      </div>
    </div>
  `).join('');
}

function addNote() {
  const drug = document.getElementById('nDrug').value.trim();
  const food = document.getElementById('nFood').value.trim();
  const memo = document.getElementById('nMemo').value.trim();
  if (!drug) { alert('お薬の名前を入力してください'); return; }

  const key = getDateKey(currentDateOffset);
  const notes = getStorage('notes_' + key);
  const now = new Date();
  const time = `${now.getHours()}:${String(now.getMinutes()).padStart(2, '0')}`;
  notes.push({ drug, food, memo, time });
  setStorage('notes_' + key, notes);

  document.getElementById('nDrug').value = '';
  document.getElementById('nFood').value = '';
  document.getElementById('nMemo').value = '';
  renderNotes();
}

function deleteNote(key, idx) {
  const notes = getStorage('notes_' + key);
  notes.splice(idx, 1);
  setStorage('notes_' + key, notes);
  renderNotes();
}

/* 既存のお薬ノートの補正（初回起動時に一度だけ）。
   以前の版はUTC基準の日付で保存していたため、日本時間の0〜9時の記録が前日の欄に入っていた。
   各記録の時刻（時:分）から本来のローカル日付を求めて移す。元データは先にバックアップとして端末に残す。 */
function migrateNotesToLocalDate() {
  try {
    if (localStorage.getItem('notes_localdate_migrated_v1')) return;
    const keys = [];
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && /^notes_\d{4}-\d{2}-\d{2}$/.test(k)) keys.push(k);
    }
    keys.sort();
    if (keys.length > 0) {
      const backup = {};
      keys.forEach(k => { backup[k] = localStorage.getItem(k); });
      localStorage.setItem('notes_backup_before_localdate_v1', JSON.stringify(backup));
      const tzEast = -new Date().getTimezoneOffset(); /* 日本は +540 分 */
      const moved = {};
      keys.forEach(k => {
        const ymd = k.slice(6).split('-').map(Number);
        getStorage(k).forEach(item => {
          let shift = 0;
          const m = /^(\d{1,2}):(\d{2})$/.exec((item && item.time) || '');
          if (m) {
            const minutes = parseInt(m[1], 10) * 60 + parseInt(m[2], 10);
            shift = -Math.floor((minutes - tzEast) / 1440);
          }
          const target = 'notes_' + localDateKey(new Date(ymd[0], ymd[1] - 1, ymd[2] + shift));
          (moved[target] = moved[target] || []).push(item);
        });
      });
      keys.forEach(k => localStorage.removeItem(k));
      Object.keys(moved).forEach(k => {
        const toMin = it => { const m = /^(\d{1,2}):(\d{2})$/.exec((it && it.time) || ''); return m ? parseInt(m[1], 10) * 60 + parseInt(m[2], 10) : 0; };
        moved[k].sort((x, y) => toMin(x) - toMin(y));
        localStorage.setItem(k, JSON.stringify(moved[k]));
      });
    }
    localStorage.setItem('notes_localdate_migrated_v1', '1');
  } catch (e) { /* 失敗しても既存の記録は変更しない */ }
}
migrateNotesToLocalDate();

function askSaveNoteFromResult() {
  if (!currentResult) return;
  const key = getDateKey(0);
  const notes = getStorage('notes_' + key);
  const now = new Date();
  const time = `${now.getHours()}:${String(now.getMinutes()).padStart(2, '0')}`;
  notes.push({ drug: currentResult.drug, food: currentResult.food, memo: `判定結果: ${currentResult.title}`, time });
  setStorage('notes_' + key, notes);
  alert('今日のお薬ノートに保存しました');
  go('note');
}

function askSaveNoteFromDetail() {
  if (!currentDetail) return;
  const key = getDateKey(0);
  const notes = getStorage('notes_' + key);
  const now = new Date();
  const time = `${now.getHours()}:${String(now.getMinutes()).padStart(2, '0')}`;
  notes.push({ drug: currentDetail.name, food: '', memo: '詳細表示より記録', time });
  setStorage('notes_' + key, notes);
  alert('今日のお薬ノートに保存しました');
  go('note');
}

/* アラーム機能 */
function renderAlarms() {
  const alarms = getStorage('alarms');
  const container = document.getElementById('alarmList');
  if (alarms.length === 0) {
    container.innerHTML = '<div class="notreg">アラームはまだありません。</div>';
    return;
  }
  container.innerHTML = alarms.map((al, idx) => `
    <div class="al-card">
      <div class="al-top">
        <div class="n">${esc(al.name)}</div>
        <div class="tgl ${al.active ? 'on' : ''}" onclick="toggleAlarm(${idx})"><i></i></div>
      </div>
      <div class="al-row">
        <span>通知時刻</span>
        <b>${esc(al.time)}</b>
      </div>
      <div class="alarm-actions">
        <button class="danger" onclick="deleteAlarm(${idx})">削除</button>
      </div>
    </div>
  `).join('');
}

function toggleMasterMute() {
  masterMuted = !masterMuted;
  const btn = document.getElementById('masterToggle');
  btn.classList.toggle('on', !masterMuted);
  btn.setAttribute('aria-checked', !masterMuted);
}

function toggleAlarm(idx) {
  const alarms = getStorage('alarms');
  alarms[idx].active = !alarms[idx].active;
  setStorage('alarms', alarms);
  renderAlarms();
}

function deleteAlarm(idx) {
  const alarms = getStorage('alarms');
  alarms.splice(idx, 1);
  setStorage('alarms', alarms);
  renderAlarms();
}

function manualAddAlarm() {
  showModal(`
    <h3>アラーム追加</h3>
    <p>設定したいお薬名と時間を指定してください。</p>
    <input id="alName" placeholder="お薬名（例：カルボシステイン）">
    <input id="alTime" type="time" value="08:00">
    <div class="modal-actions">
      <button class="cancel" onclick="closeModal()">キャンセル</button>
      <button class="ok" onclick="saveNewAlarm()">保存</button>
    </div>
  `);
}

function saveNewAlarm() {
  const name = document.getElementById('alName').value.trim() || 'お薬の時間';
  const time = document.getElementById('alTime').value;
  if (!time) return;

  const alarms = getStorage('alarms');
  alarms.push({ name, time, active: true });
  setStorage('alarms', alarms);
  closeModal();
  renderAlarms();
}

function askSetAlarm() {
  go('alarm');
  manualAddAlarm();
}

/* バックグラウンド擬似監視（タブが開いている間のタイマー） */
setInterval(() => {
  if (masterMuted) return;
  const now = new Date();
  const current = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  if (now.getSeconds() === 0) {
    const alarms = getStorage('alarms');
    alarms.forEach(al => {
      if (al.active && al.time === current) {
        alert(`⏰ 【お薬の時間です】\n${al.name}`);
      }
    });
  }
}, 1000);
</script>
</body>
