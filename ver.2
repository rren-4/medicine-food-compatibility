  { label: '乳酸菌飲料', any: ['乳酸菌飲料', 'ヤクルト', 'カルピス'] },
  { label: 'スポーツドリンク', any: ['スポーツ', 'ポカリ', 'アクエリアス'] },
  { label: 'お茶（麦茶など）', any: ['茶'] },
  { label: 'ヨーグルト', any: ['ヨーグルト'] },
  { label: 'ゼリー（服薬ゼリーなど）', any: ['服薬ゼリー', 'おくすり飲めたね', 'ゼリーの素', 'オレンジゼリー'] },
  { label: 'アイスクリーム', any: ['アイス', 'スーパーカップ', 'ハーゲンダッツ'] },
