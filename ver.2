let currentResult = null;
let currentDetail = null;
let currentDateOffset = 0;
let masterMuted = false;

function go(pageId) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('on'));
  document.querySelectorAll('.bottomnav button').forEach(b => b.classList.remove('on'));
  const target = document.getElementById(pageId);
  if (target) target.classList.add('on');
  const btn = document.querySelector(`.bottomnav button[data-p="${pageId}"]`);
  if (btn) btn.classList.add('on');
  window.scrollTo(0,0);
  
  if (pageId === 'note') renderNotes();
  if (pageId === 'alarm') renderAlarms();
}

document.querySelectorAll('.bottomnav button').forEach(btn => {
  btn.addEventListener('click', () => {
    const p = btn.getAttribute('data-p');
    if (p) go(p);
  });
});

function doSearch() {
  const inp = document.getElementById('homeSearch');
  const q = inp.value.trim();
  if (!q) return;
  const ql = q.toLowerCase();
  const matches = ALL_DRUGS.filter(d => d.n.toLowerCase().includes(ql) || d.k.toLowerCase().includes(ql));
  const exact = matches.find(d => d.n === q);
  if (exact || matches.length === 1) {
    showDetail((exact || matches[0]).c);
  } else if (matches.length === 0) {
    alert("該当するお薬が見つかりませんでした。別のキーワードでお試しください。");
  } else {
    /* 複数の候補があるときは、先頭を黙って選ばず、候補から選んでもらう */
    inp.dispatchEvent(new Event('input'));
    const st = document.getElementById('searchStatus');
    if (st) st.textContent = `${matches.length}件の候補があります。お薬を選んでください`;
  }
}

/* 文字の正規化（全角/半角・大文字小文字・空白の違いを吸収）と、HTML埋め込み用のエスケープ */
function norm(s) { return String(s == null ? '' : s).normalize('NFKC').toLowerCase().replace(/\s+/g, ''); }
function esc(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/* ---- 薬の詳細ページ：基本の服用（水）＋ 飲食品との相性を4段階でまとめて表示 ---- */
const J_RANK = { bad: 3, warn: 2, good: 1, none: 0 };
const J_LABEL = { bad: '避ける', warn: '注意', good: '使用可能', none: '情報なし' };
const J_ICON = { bad: '🔴', warn: '🟡', good: '🟢', none: '⚪' };
const J_GROUP = { bad: '避ける', warn: '注意', good: '使用可能（根拠あり）', none: '情報なし' };
const J_DESC = {
  bad: '資料上、避けるべきとされている飲食品です。',
  warn: '条件や量によって、注意が必要な飲食品です。',
