];

/* 水（白湯・湯冷まし・天然水・温湯など）の判定。「水酸化…」のような薬の成分名は含めない */
const WATER_WORDS = ['白湯', '湯冷まし', '天然水', 'ミネラルウォーター', '温湯', 'お湯', '熱湯'];
function isWaterFood(s) {
  const rn = norm(s);
  return /^水($|[・(（])/.test(rn) || WATER_WORDS.some(k => rn.includes(norm(k)));
}
function isWaterRow(r) {
  if (norm(r.f).includes('、')) return false; /* 複数の飲食品をまとめた行は水の行として扱わない */
  return isWaterFood(r.f);
}

function badgeHtml(j) { return `<span class="badge ${j}">${J_ICON[j]} ${J_LABEL[j]}</span>`; }

function rangeItemHtml(n) {
  return `<div class="range-item"><div class="ri-t">${esc(n.w || '（確認対象の記載なし）')}</div>`
    + fbBlock('資料での確認結果', n.r)
    + fbBlock('追加で必要なこと', n.n)
    + `</div>`;
}

function foodMatches(cf, r) {
  const rn = norm(r.f);
  return (cf.any || []).some(k => rn.includes(norm(k)));
}

function fbBlock(title, text) {
  return text ? `<div class="fb"><b>${title}</b>${esc(text)}</div>` : '';
}

/* タップで開く、判定の詳細（なぜ・相互作用の内容・根拠資料・根拠ページ・注意点） */
function foodPanelHtml(x) {
  let body = '';
  if (x.kind === 'db') {
    const r = x.r;
    if (r.m && r.m !== r.d) {
      body += fbBlock(`判定理由（なぜ「${J_LABEL[x.j]}」？）`, r.m);
      body += fbBlock('相互作用の内容', r.d);
    } else {
      body += fbBlock(`判定理由・相互作用の内容（なぜ「${J_LABEL[x.j]}」？）`, r.d);
    }
    body += fbBlock('根拠資料（資料の種類）', r.sr);
    body += fbBlock('根拠ページ', r.pg);
    body += fbBlock('エビデンスの種類', r.e);
    body += fbBlock('定量的な影響', r.q);
    body += fbBlock('使うときの注意点', r.a);
    body += fbBlock('備考', r.n);
  } else if (x.kind === 'ni') {
    body += fbBlock('資料での確認結果', x.r.r);
    body += fbBlock('追加で必要なこと', x.r.n);
    body += `<div class="fb"><b>大切なこと</b>確認できる資料から、この組み合わせについて十分な情報が見つかっていません。「情報なし」は「安全」という意味ではありません。使う前に医師・薬剤師に確認してください。</div>`;
  } else {
    body += `<div class="fb"><b>この飲食品について</b>確認できる資料から、この組み合わせについて十分な情報が見つかっていません。</div>`;
    body += `<div class="fb"><b>大切なこと</b>「情報なし」は「安全」という意味ではありません。使う前に医師・薬剤師に確認してください。</div>`;
  }
  const sub = x.y ? `<span style="color:var(--sub);font-size:.72rem;font-weight:400;">（${esc(x.y)}）</span>` : '';
  return `<div class="fp-title">${J_ICON[x.j]} ${esc(x.f)} ${sub}</div>${body}`;
}

let foodItems = [];
function openFood(i, btn) {
  const grp = btn.closest('.grp');
  const panel = grp.querySelector('.fpanel');
  const wasOn = btn.classList.contains('on');
  document.querySelectorAll('#dtBody .fchipx.on').forEach(b => b.classList.remove('on'));
  document.querySelectorAll('#dtBody .fpanel').forEach(p => { p.style.display = 'none'; p.innerHTML = ''; });
  if (wasOn) return;
  btn.classList.add('on');
  panel.innerHTML = foodPanelHtml(foodItems[i]);
  panel.style.display = 'block';
}

/* 水・服薬の工夫などの「資料の記載」1件分（badge=true のときだけ判定バッジを付ける） */
function tipRowHtml(r, badge, extra) {
  let more = '';
  more += fbBlock('資料に書かれている内容', r.d);
  more += fbBlock('根拠資料（資料の種類）', r.sr);
  more += fbBlock('根拠ページ', r.pg);
  more += fbBlock('エビデンスの種類', r.e);
  more += fbBlock('定量的な影響', r.q);
  more += fbBlock('備考', r.n);
  return `<div class="tipitem"><div class="tt"><span>${esc(r.f)}</span>${badge ? badgeHtml(r.j) : ''}</div>`
    + (extra ? `<div class="ti-do" style="color:var(--bad-tx);">${esc(extra)}</div>` : '')
    + (r.a ? `<div class="ti-do">▶ ${esc(r.a)}</div>` : '')
    + (more ? `<details><summary>根拠を見る</summary><div class="fbody" style="border-top:none;padding:0 0 4px;">${more}</div></details>` : '')
    + `</div>`;
}

function goCheckFromDetail() {
  if (currentDetail) {
    document.getElementById('ckDrug').value = currentDetail.name;
    document.getElementById('ckFood').value = '';
  }
  go('checkform');
}

function showDetail(code) {
  const d = DETAIL[code];
  if (!d) return;
  currentDetail = d;
  document.getElementById('dtName').textContent = d.name;
  document.getElementById('dtCat').textContent = d.cat;

  const rows = d.rows || [];
  const waterRows = rows.filter(isWaterRow);             /* 水に関する資料の記載 → 基本の服用 */
  const rest = rows.filter(r => !isWaterRow(r));
  const mainRows = rest.filter(r => !r.t);                /* 飲食品との相性（4段階） */
  const tipRows = rest.filter(r => r.t);                  /* 服薬のしかた・工夫 */
  const waterNoteBad = rest.filter(r => r.y === '服用・投与方法' && r.j === 'bad'); /* 水以外の服用方法の指示（避ける） */
  const ni = d.ni || [];

  foodItems = mainRows.map(r => ({ kind: 'db', f: r.f, y: r.y, j: r.j, r }));
  /* 「情報なし」の記録（食事全般・一般飲食品全体など、範囲単位の記録）があるお薬では、
     その記録から牛乳・ジュースなど個別の食品まで⚪として並べない。記録は「資料で確認できなかった範囲」に別表示する。
     DBに個別の行がある食品は、上で通常どおり判定を表示する。 */
  if (ni.length === 0) {
    COMMON_FOODS.forEach(cf => {
      if (rest.some(r => foodMatches(cf, r))) return;
      foodItems.push({ kind: 'gap', f: cf.label, y: '', j: 'none' });
    });
  }
  foodItems.forEach((x, i) => { x.i = i; });

  let html = '';
  if (d.alert) {
    html += `<div class="alert-banner">⚠️ 警告: ${esc(d.alert)}</div>`;
  }

  /* 💧 基本の服用：水（4段階の対象外） */
  html += `<div class="water"><div class="water-h">💧 基本の服用</div><div class="water-name">水</div>`;
  html += `<div class="water-d">通常の服用に使う基本的な飲み物です。水は4段階の相性判定の対象には含めていません。</div>`;
  if (waterRows.length > 0 || waterNoteBad.length > 0) {
    html += `<div class="water-info"><b>このお薬について、水に関する資料の記載があります</b>`;
    html += waterRows.map(r => tipRowHtml(r, false)).join('');
    html += waterNoteBad.map(r => tipRowHtml(r, false, '資料上「避ける」とされている記載です。下の「🔴 避ける」でも確認できます。')).join('');
    html += `</div>`;
  }
  html += `</div>`;

  /* 🍽️ 飲食品との相性：判定ごとに該当する飲食品をまとめて表示 */
  html += `<div class="dsec"><div class="dsec-h">🍽️ 一緒に使いたい飲食品との相性</div>`;
  html += `<div class="dsec-sub">データベースにある飲食品を、判定ごとにまとめています。飲食品の名前をタップすると、判定理由・相互作用の内容・根拠資料・根拠ページが開きます。</div>`;
  if (foodItems.length === 0) {
    html += `<div class="grp-empty">このお薬には、飲食品ごとの判定がデータベースにありません。${ni.length > 0 ? '下の「資料で確認できなかった範囲」を確認してください。' : '使う前に医師・薬剤師に確認してください。'}</div>`;
  }
  ['bad', 'warn', 'good', 'none'].forEach(j => {
    const list = foodItems.filter(x => x.j === j);
    if (list.length === 0) return;
    html += `<div class="grp g-${j}"><div class="grp-h"><span aria-hidden="true">${J_ICON[j]}</span>${J_GROUP[j]}<span class="grp-n">${list.length}件</span></div>`;
    html += `<div class="grp-d">${J_DESC[j]}</div>`;
    if (j === 'bad') {
      /* 「避ける」は、なぜ避けるのか（資料の記載）をタップしなくても見えるようにする */
      html += list.map(x => `<div class="why"><b>${esc(x.f)}</b>：${esc(x.r.m || x.r.d)}</div>`).join('');
    }
    html += `<div class="chips">` + list.map(x => `<button type="button" class="fchipx" onclick="openFood(${x.i}, this)">${esc(x.f)}</button>`).join('') + `</div>`;
    html += `<div class="fpanel" style="display:none;"></div></div>`;
  });
  html += `</div>`;

  if (ni.length > 0) {
    html += `<div class="dsec"><div class="dsec-h">📋 資料で確認できなかった範囲</div>`;
    html += `<div class="dsec-sub">資料全体について「確認できなかった」と記録されている範囲です。上の飲食品ごとの判定とは別の情報で、個別の飲食品（牛乳・ジュースなど）が「情報なし」と判定されたという意味ではありません。</div>`;
    html += `<div class="none-note"><b>「情報なし」は「安全」という意味ではありません。</b>使う前に医師・薬剤師に確認してください。</div>`;
    html += ni.map(rangeItemHtml).join('');
    html += `</div>`;
  }

  if (tipRows.length > 0) {
    html += `<div class="dsec"><div class="dsec-h">🥄 服薬を助ける工夫</div>`;
    html += `<div class="dsec-sub">お薬の飲ませ方・準備のしかたに関する資料の記載です。上の「飲食品との相性」とは別の情報で、飲ませやすさを保証するものではありません。</div>`;
    html += tipRows.map(r => tipRowHtml(r, true)).join('');
    html += `</div>`;
  }

  if (d.notice) {
    html += `<div class="notice"><b>💡 取扱上の注意・備考</b><br>${esc(d.notice)}</div>`;
  }

  document.getElementById('dtBody').innerHTML = html;
  go('detail');
}

/* 候補の2行目：成分名・剤形・メーカー（同じ成分でも販売名・剤形が違う薬を選び間違えないようにする） */
function suggestSubText(m) {
  const parts = [];
  if (m.g) parts.push('成分：' + m.g);
  if (m.f) parts.push('剤形：' + m.f);
  if (m.mk) parts.push('メーカー：' + m.mk);
  return parts.join(' ／ ');
}

function setupSuggest(inputId, boxId, statusId, onPick) {
  const inp = document.getElementById(inputId);
  const box = document.getElementById(boxId);
  const st = document.getElementById(statusId);
  if (!inp || !box) return;

  inp.addEventListener('input', () => {
    const val = inp.value.trim().toLowerCase();
    if (!val) {
      box.style.display = 'none';
      if (st) st.textContent = '';
      return;
    }
    const all = ALL_DRUGS.filter(d => d.n.toLowerCase().includes(val) || d.k.toLowerCase().includes(val));
    const matches = all.slice(0, 8);
    if (matches.length === 0) {
      box.style.display = 'none';
      if (st) st.textContent = '該当する候補はありません';
      return;
    }
    box.innerHTML = '';
    matches.forEach(m => {
      const btn = document.createElement('button');
      btn.className = 'sugg-item';
      btn.type = 'button';
      const nm = document.createElement('span');
      nm.className = 'sg-name';
      nm.textContent = m.n;
      const sb = document.createElement('span');
      sb.className = 'sg-sub';
      sb.textContent = suggestSubText(m);
      btn.appendChild(nm);
      btn.appendChild(sb);
      btn.onclick = () => {
        inp.value = m.n;
        box.style.display = 'none';
        if (st) st.textContent = '';
        if (onPick) onPick(m.c);
      };
      box.appendChild(btn);
    });
    if (all.length > matches.length) {
      const more = document.createElement('div');
      more.className = 'sugg-more';
      more.textContent = `ほか${all.length - matches.length}件あります。成分名や剤形・規格を入力すると絞り込めます`;
      box.appendChild(more);
    }
    box.style.display = 'block';
    if (st) st.textContent = `${all.length}件の候補があります`;
  });

  document.addEventListener('click', (e) => {
    if (!inp.contains(e.target) && !box.contains(e.target)) {
      box.style.display = 'none';
    }
  });
}

