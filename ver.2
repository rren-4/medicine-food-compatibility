function quick(drug, food) {
  document.getElementById('ckDrug').value = drug;
  document.getElementById('ckFood').value = food;
  runCheck();
}

function runCheck() {
  const drug = document.getElementById('ckDrug').value.trim();
  const food = document.getElementById('ckFood').value.trim();
  if (!drug) {
    alert("お薬の名前を入力してください");
    return;
  }

  const dl = drug.toLowerCase();
  const cands = ALL_DRUGS.filter(d => d.n.toLowerCase().includes(dl) || d.k.toLowerCase().includes(dl));
  const found = cands.find(d => d.n === drug) || (cands.length === 1 ? cands[0] : null);
  if (!found && cands.length > 1) {
    alert(`「${drug}」に当てはまるお薬が複数あります。候補から選んでください。`);
    document.getElementById('ckDrug').dispatchEvent(new Event('input'));
    return;
  }
  const detail = found ? DETAIL[found.c] : null;

  let type = 'none';
  let title = '情報なし';
  let icon = '？';
  let meaning = '確認できる資料から、この組み合わせについて十分な情報が見つかっていません。「情報なし」は「安全」という意味ではありません。';
  let reason = detail ? 'この組み合わせに関する情報は、データベースにありません。' : 'お薬がデータベースに見つかりませんでした。';
  let tip = '服用方法や混ぜるものについては、医師・薬剤師に確認してください。';
  let source = 'データ未登録';
  let matched = [];

  if (detail && (!food || isWaterFood(food))) {
    /* 水は4段階判定の対象外：基本の服用として表示する */
    const wr = (detail.rows || []).filter(isWaterRow);
    type = 'best';
    title = '基本の服用：水';
    icon = '💧';
    meaning = '水は通常の服用に使う基本的な飲み物として扱い、4段階の相性判定の対象にはしていません。';
    reason = wr.length ? wr.map(r => `${r.f}：${r.d}`).join('\n') : '水は、通常の服用に使う基本的な飲み物です。';
    const tips = wr.map(r => r.a).filter(Boolean);
    tip = tips.length ? tips.join('\n') : '特別な指示がある場合は、医師・薬剤師の指示に従ってください。';
    source = wr.length ? (wr[0].s || '-') : '-';
  } else if (detail) {
    const foodN = norm(food);
    const rows = detail.rows || [];
    let hit;
    if (foodN) {
      hit = rows.filter(r => { const rn = norm(r.f); return rn.includes(foodN) || foodN.includes(rn); });
    } else {
      /* 飲食品が未入力のときは「水・基本の飲み方」として、水・白湯の記載を対象にする */
      hit = rows.filter(r => { const rn = norm(r.f); return rn.startsWith('水') || rn.includes('白湯'); });
    }

    if (hit.length > 0) {
      const rank = { bad: 3, warn: 2, good: 1 };
      const sorted = hit.slice().sort((x, y) => rank[y.j] - rank[x.j]);
      const top = sorted[0];
      type = top.j;
      if (type === 'bad') {
        title = '避けるべき組み合わせ';
        icon = '❌';
        meaning = '資料上、避けるべきとされている組み合わせです。服用前に医師・薬剤師へ確認してください。';
      } else if (type === 'warn') {
        title = '注意が必要な組み合わせ';
        icon = '⚠️';
        meaning = '条件によっては注意が必要な組み合わせです。内容を確認してから使用してください。';
      } else {
        title = '使用可能';
        icon = '⭕';
        meaning = '資料に基づき、この組み合わせで問題となる記載は確認されていません。';
      }
      if (hit.some(r => r.j !== top.j)) {
        meaning += '（複数の該当があり、最も注意度の高い判定を表示しています）';
      }
      reason = (top.m && top.m !== top.d) ? `${top.d}（理由・機序：${top.m}）` : top.d;
      tip = top.a || tip;
      source = top.s || '-';
      matched = sorted.map(r => r.f).filter((f, i, arr) => arr.indexOf(f) === i);
    } else {
      reason = 'この飲食品について、データベースに個別の記載がありません。';
      if (detail.ni && detail.ni.length > 0) {
        reason += '\n【資料で確認できなかった範囲】\n' + detail.ni.map(n => `${n.w || '（確認対象の記載なし）'}：${n.r}`).join('\n');
      }
    }
  }

  currentResult = { drug, food, type, title, icon, meaning, reason, tip, source };

  const vBox = document.getElementById('verdictBox');
  vBox.className = `verdict ${type}`;
  document.getElementById('verdictIcon').textContent = icon;
  document.getElementById('verdictText').textContent = title;
  document.getElementById('resDrugFood').textContent = `${drug} × ${food || '水・基本の飲み方'}`;
  document.getElementById('resMeaning').textContent = meaning;
  document.getElementById('resReason').textContent = reason;
  document.getElementById('resTip').textContent = tip;
  document.getElementById('resTagline').innerHTML = matched.length
    ? `<span style="border:none;background:none;padding:4px 0;color:var(--sub);">データベース上の該当:</span>` + matched.map(f => `<span>${esc(f)}</span>`).join('')
    : '';
  document.getElementById('resSource').textContent = source;

  go('result');
}

